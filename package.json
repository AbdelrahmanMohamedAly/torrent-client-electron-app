{
  "name": "current",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "desktop:start": "npm run build && electron .",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "parse-torrent": "^11.0.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "webtorrent": "^3.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "buffer": "^6.0.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "oxlint": "^1.71.0",
    "process": "^0.11.10",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "wait-on": "^9.0.3"
  }
}
